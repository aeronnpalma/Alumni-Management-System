<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart Traffic Management System</title>
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --primary-soft: #eff6ff;
      --dark: #0f172a;
      --dark-2: #111827;
      --dark-3: #1e293b;
      --text: #1e293b;
      --muted: #64748b;
      --light: #f8fafc;
      --border: #e2e8f0;
      --white: #ffffff;
      --green: #10b981;
      --green-soft: #dcfce7;
      --yellow: #f59e0b;
      --yellow-soft: #fef3c7;
      --red: #ef4444;
      --red-soft: #fee2e2;
      --shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 18px 50px rgba(15, 23, 42, 0.14);
      --sidebar-width: 260px;
      --header-height: 74px;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Inter, Arial, Helvetica, sans-serif;
      background: #f1f5f9;
      color: var(--text);
      min-height: 100vh;
    }

    button, input, select {
      font: inherit;
    }

    button {
      cursor: pointer;
      border: none;
    }

    .hidden {
      display: none !important;
    }

    /* Login */
    #loginPage {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background:
        radial-gradient(circle at 20% 20%, rgba(37, 99, 235, 0.18), transparent 28%),
        radial-gradient(circle at 80% 80%, rgba(14, 165, 233, 0.12), transparent 32%),
        #f1f5f9;
    }

    .login-container {
      width: 420px;
      max-width: 100%;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 22px;
      padding: 40px 32px;
      box-shadow: var(--shadow-lg);
    }

    .login-logo {
      text-align: center;
      margin-bottom: 30px;
    }

    .login-icon {
      width: 76px;
      height: 76px;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 22px;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: white;
      font-size: 38px;
      box-shadow: 0 12px 25px rgba(37, 99, 235, 0.28);
    }

    .login-logo h1 {
      font-size: 25px;
      color: var(--dark);
    }

    .login-logo p {
      margin-top: 6px;
      font-size: 14px;
      color: var(--muted);
    }

    .login-group {
      margin-bottom: 18px;
    }

    .login-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--text);
    }

    .input-wrapper {
      position: relative;
    }

    .login-group input {
      width: 100%;
      height: 48px;
      padding: 0 45px 0 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      outline: none;
      transition: 0.2s ease;
    }

    .login-group input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }

    .password-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      color: var(--muted);
      font-size: 14px;
    }

    .login-btn {
      width: 100%;
      height: 49px;
      border-radius: 10px;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: white;
      font-weight: 700;
      transition: 0.2s ease;
    }

    .login-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
    }

    .login-demo {
      font-size: 12px;
      text-align: center;
      color: var(--muted);
      margin-top: 18px;
      line-height: 1.5;
    }

    /* Sidebar */
    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      width: var(--sidebar-width);
      height: 100vh;
      background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
      color: white;
      padding: 22px 14px;
      z-index: 1000;
      overflow-y: auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 5px 10px 26px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 22px;
    }

    .brand-icon {
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: rgba(37, 99, 235, 0.18);
      font-size: 26px;
    }

    .brand h2 {
      font-size: 17px;
      line-height: 1.2;
    }

    .brand p {
      color: #94a3b8;
      font-size: 11px;
      margin-top: 4px;
    }

    .menu-title {
      color: #64748b;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 12px 12px 8px;
    }

    .menu button {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 13px;
      margin-bottom: 4px;
      border-radius: 10px;
      background: transparent;
      color: #cbd5e1;
      text-align: left;
      font-size: 13px;
      transition: 0.2s ease;
    }

    .menu button:hover {
      background: rgba(255, 255, 255, 0.07);
      color: white;
    }

    .menu button.active {
      background: linear-gradient(135deg, rgba(37, 99, 235, 1), rgba(29, 78, 216, 0.88));
      color: white;
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }

    .menu-icon {
      width: 20px;
      text-align: center;
      font-size: 16px;
    }

    .sidebar-footer {
      margin-top: 35px;
      padding: 15px 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      color: #64748b;
      font-size: 10px;
      line-height: 1.5;
    }

    /* Main area */
    .main {
      margin-left: var(--sidebar-width);
      min-height: 100vh;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      height: var(--header-height);
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 30px;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .mobile-button {
      display: none;
      width: 40px;
      height: 40px;
      border-radius: 9px;
      background: var(--dark);
      color: white;
    }

    .header-title h1 {
      font-size: 20px;
      font-weight: 800;
    }

    .header-title p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .clock {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .profile-icon {
      width: 39px;
      height: 39px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: white;
      font-weight: 800;
    }

    .profile-text strong {
      font-size: 13px;
    }

    .profile-text p {
      color: var(--muted);
      font-size: 10px;
      margin-top: 2px;
    }

    .content {
      padding: 28px;
    }

    .page {
      display: none;
      animation: pageIn 0.25s ease;
    }

    .page.active {
      display: block;
    }

    @keyframes pageIn {
      from {
        opacity: 0;
        transform: translateY(5px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Cards */
    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 17px;
      margin-bottom: 22px;
    }

    .card {
      position: relative;
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.035);
      overflow: hidden;
      transition: 0.2s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }

    .card::after {
      content: "";
      position: absolute;
      right: -25px;
      top: -25px;
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: rgba(37, 99, 235, 0.05);
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-title {
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .card-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .icon-blue { background: #eff6ff; color: #2563eb; }
    .icon-green { background: #ecfdf5; color: #059669; }
    .icon-orange { background: #fff7ed; color: #ea580c; }
    .icon-red { background: #fef2f2; color: #dc2626; }

    .card-number {
      font-size: 29px;
      font-weight: 800;
      margin-top: 14px;
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: 5px;
      color: var(--muted);
      font-size: 11px;
      margin-top: 6px;
    }

    .up {
      color: var(--green);
      font-weight: 700;
    }

    /* Box */
    .box {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px;
      margin-bottom: 20px;
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.035);
    }

    .box-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .box-header h2 {
      font-size: 17px;
    }

    .box-header p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 4px;
    }

    .box-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 38px;
      padding: 0 14px;
      border-radius: 9px;
      background: var(--primary);
      color: white;
      font-size: 12px;
      font-weight: 700;
      transition: 0.2s ease;
    }

    .btn:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: #f1f5f9;
      color: #334155;
    }

    .btn-secondary:hover {
      background: #e2e8f0;
    }

    .btn-green {
      background: var(--green);
    }

    .btn-green:hover {
      background: #059669;
    }

    .btn-danger {
      background: var(--red);
    }

    .btn-danger:hover {
      background: #dc2626;
    }

    .btn-small {
      min-height: 31px;
      padding: 0 10px;
      font-size: 11px;
    }

    /* Traffic grid */
    .traffic-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 18px;
    }

    .road-item {
      border: 1px solid var(--border);
      padding: 17px;
      border-radius: 11px;
      margin-bottom: 10px;
      transition: 0.2s ease;
    }

    .road-item:hover {
      border-color: #bfdbfe;
      background: #fafcff;
    }

    .road-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .road-name {
      font-size: 13px;
      font-weight: 800;
    }

    .road-location {
      color: var(--muted);
      font-size: 11px;
      margin-top: 4px;
    }

    .progress-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .progress {
      height: 8px;
      flex: 1;
      background: #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      border-radius: 20px;
      transition: width 0.5s ease;
    }

    .progress-green { background: linear-gradient(90deg, #10b981, #34d399); }
    .progress-orange { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .progress-red { background: linear-gradient(90deg, #ef4444, #f87171); }

    .progress-value {
      width: 35px;
      text-align: right;
      font-size: 11px;
      font-weight: 800;
    }

    .status-summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .summary-box {
      padding: 15px;
      border-radius: 11px;
      text-align: center;
      border: 1px solid var(--border);
    }

    .summary-box strong {
      display: block;
      font-size: 21px;
    }

    .summary-box span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-top: 4px;
    }

    .summary-green { background: #f0fdf4; }
    .summary-orange { background: #fffbeb; }
    .summary-red { background: #fef2f2; }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      border-radius: 30px;
      font-size: 10px;
      font-weight: 800;
    }

    .status::before {
      content: "";
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
    }

    .low { background: var(--green-soft); color: #15803d; }
    .moderate { background: var(--yellow-soft); color: #a16207; }
    .heavy, .active-status { background: var(--red-soft); color: #b91c1c; }
    .resolved { background: var(--green-soft); color: #15803d; }

    /* Flow */
    .flow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .flow-item {
      min-width: 125px;
      padding: 15px;
      border-radius: 11px;
      background: var(--primary-soft);
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      text-align: center;
      font-size: 12px;
      font-weight: 800;
    }

    .arrow {
      color: #94a3b8;
      font-size: 18px;
    }

    /* Tables */
    .table-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .search-box {
      position: relative;
      width: 280px;
      max-width: 100%;
    }

    .search-box input {
      width: 100%;
      height: 38px;
      padding: 0 13px 0 36px;
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
      font-size: 12px;
    }

    .search-box input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    th, td {
      padding: 12px 10px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      vertical-align: middle;
    }

    th {
      background: #f8fafc;
      color: var(--text);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    tbody tr:hover {
      background: #fafcff;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 10px;
      font-size: 10px;
      font-weight: 700;
      border-radius: 20px;
      background: #eef2ff;
      color: #4338ca;
    }

    .badge.success { background: #ecfdf5; color: #047857; }
    .badge.warning { background: #fff7ed; color: #c2410c; }
    .badge.danger { background: #fef2f2; color: #b91c1c; }

    .action-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Forms */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      min-height: 42px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
      background: #fff;
      transition: 0.2s ease;
    }

    .form-group textarea {
      min-height: 110px;
      resize: vertical;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    }

    .full {
      grid-column: 1 / -1;
    }

    /* Analytics */
    .analytics-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .chart-box {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px;
    }

    .chart-box h3 {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .mini-bars {
      display: flex;
      align-items: end;
      gap: 10px;
      height: 150px;
      padding-top: 20px;
    }

    .mini-bar-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      height: 100%;
      justify-content: flex-end;
    }

    .mini-bar {
      width: 100%;
      max-width: 38px;
      border-radius: 10px 10px 0 0;
      background: linear-gradient(180deg, #77a8ff, #2563eb);
    }

    .mini-bar-label {
      font-size: 10px;
      color: var(--muted);
    }

    .donut {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: conic-gradient(#2563eb 0 55%, #10b981 55% 80%, #f59e0b 80% 100%);
      margin: 0 auto 12px;
      position: relative;
    }

    .donut::before {
      content: "";
      position: absolute;
      inset: 18px;
      background: white;
      border-radius: 50%;
    }

    .legend {
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .dot-blue { background: #2563eb; }
    .dot-green { background: #10b981; }
    .dot-yellow { background: #f59e0b; }

    /* Responsive */
    @media (max-width: 1100px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .traffic-grid,
      .analytics-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 820px) {
      .sidebar {
        position: fixed;
        left: -100%;
        transition: left 0.2s ease;
      }

      .sidebar.open {
        left: 0;
      }

      .main {
        margin-left: 0;
      }

      .mobile-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .header {
        padding: 0 18px;
      }

      .content {
        padding: 18px;
      }
    }

    @media (max-width: 620px) {
      .cards,
      .form-grid,
      .status-summary {
        grid-template-columns: 1fr;
      }

      .header {
        flex-wrap: wrap;
        height: auto;
        padding: 12px 18px;
      }

      .header-right {
        width: 100%;
        justify-content: space-between;
      }

      .table-toolbar {
        flex-direction: column;
        align-items: flex-start;
      }

      .search-box {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div id="loginPage">
    <div class="login-container">
      <div class="login-logo">
        <div class="login-icon">🚦</div>
        <h1>Smart Traffic</h1>
        <p>Management System</p>
      </div>

      <form id="loginForm">
        <div class="login-group">
          <label for="username">Username</label>
          <div class="input-wrapper">
            <input id="username" type="text" placeholder="Enter username" required />
          </div>
        </div>

        <div class="login-group">
          <label for="password">Password</label>
          <div class="input-wrapper">
            <input id="password" type="password" placeholder="Enter password" required />
            <button type="button" class="password-toggle" id="togglePassword">👁</button>
          </div>
        </div>

        <button class="login-btn" type="submit">LOGIN</button>
        <div class="login-demo">Demo: use any username and password to access the dashboard.</div>
      </form>
    </div>
  </div>

  <div id="app" class="hidden">
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="brand-icon">🚦</div>
        <div>
          <h2>Smart Traffic</h2>
